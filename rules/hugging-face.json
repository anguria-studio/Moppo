{
  "id": "hugging-face",
  "name": "Hugging Face",
  "section": "ai-tools",
  "aiTool": {
    "case": "huggingFace",
    "rawValue": "HuggingFace"
  },
  "owner": {
    "case": "huggingFace",
    "name": "Hugging Face"
  },
  "removalRules": "Model rows retain shared-file grouping. They require review and are not disposable caches. Shared, linked, or open model files stay protected.",
  "storage": [
    {
      "path": "~/.cache/huggingface",
      "type": "download",
      "table": "localModelStores",
      "owner": "aiTools",
      "treatment": "review",
      "store": "huggingFace",
      "comment": "The hub inside carries `CACHEDIR.TAG`. The reader handles the classic layout and the shared blob layout.",
      "custom": {
        "variables": [
          {
            "name": "HF_HOME"
          },
          {
            "name": "XDG_CACHE_HOME",
            "append": "huggingface"
          }
        ],
        "identifiedBy": [
          "hub/models--*",
          "hub/datasets--*",
          "hub/spaces--*"
        ],
        "expandsHome": true
      }
    },
    {
      "path": "~/.cache/huggingface/hub",
      "type": "download",
      "table": "localModelStores",
      "owner": "aiTools",
      "treatment": "review",
      "store": "huggingFaceHub",
      "claimed": false,
      "custom": {
        "variables": [
          {
            "name": "HF_HUB_CACHE"
          },
          {
            "name": "HUGGINGFACE_HUB_CACHE"
          },
          {
            "name": "HF_HOME",
            "append": "hub"
          },
          {
            "name": "XDG_CACHE_HOME",
            "append": "huggingface/hub"
          }
        ],
        "identifiedBy": [
          "models--*",
          "datasets--*",
          "spaces--*"
        ],
        "expandsHome": true
      },
      "comment": "`huggingface_hub` uses the first of these variables that is set, and expands `~` in the value."
    }
  ]
}

{
  "id": "pytorch",
  "name": "PyTorch",
  "section": "ai-tools",
  "aiTool": {
    "case": "pyTorch",
    "rawValue": "PyTorch"
  },
  "owner": {
    "case": "pyTorch",
    "name": "PyTorch"
  },
  "removalRules": "One row for each weight file in `checkpoints` and each downloaded repository. Other folders in `~/.cache/torch` stay in System Caches & Logs.",
  "storage": [
    {
      "path": "~/.cache/torch/hub",
      "type": "download",
      "table": "localModelStores",
      "owner": "aiTools",
      "treatment": "review",
      "store": "pyTorchHub",
      "note": "Weight files sit in `checkpoints`, and each downloaded repository has its own folder. Other folders in `~/.cache/torch` are compiler caches.",
      "custom": {
        "variables": [
          {
            "name": "TORCH_HOME",
            "append": "hub"
          },
          {
            "name": "XDG_CACHE_HOME",
            "append": "torch/hub"
          }
        ],
        "identifiedBy": [
          "checkpoints",
          "*/hubconf.py"
        ],
        "expandsHome": true
      }
    }
  ]
}

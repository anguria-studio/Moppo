{
  "id": "perlbrew",
  "name": "perlbrew",
  "section": "perl",
  "storage": [
    {
      "path": "~/perl5/perlbrew/perls/<version>",
      "type": "installed",
      "coverage": "no",
      "recognition": "`perlbrew list`",
      "removal": "`perlbrew uninstall <version>`",
      "restore": "`perlbrew install <version>`",
      "verified": {
        "date": "2026-11-02",
        "macos": "27.2",
        "tool": "perl-5.44.0 through perlbrew"
      }
    },
    {
      "paths": [
        "~/perl5/perlbrew/build",
        "~/perl5/perlbrew/dists"
      ],
      "type": "cache",
      "coverage": "no",
      "recognition": "perlbrew layout",
      "removal": "`perlbrew clean`",
      "restore": "Next install",
      "verified": {
        "date": "2026-11-02",
        "macos": "27.2",
        "tool": "perlbrew"
      }
    }
  ]
}

{
  "id": "bundler",
  "name": "Bundler",
  "section": "ruby",
  "versionCommand": [
    "bundle",
    "--version"
  ],
  "storage": [
    {
      "path": "<project>/vendor/bundle",
      "type": "download",
      "coverage": "row",
      "recognition": "`Gemfile.lock` beside `vendor`, and `BUNDLE_PATH` in `.bundle/config`",
      "removal": "Trash, only if Git does not track it",
      "restore": "`bundle install`. A network connection is necessary.",
      "verified": {
        "date": "2026-11-04",
        "macos": "27.2",
        "tool": "Bundler 2.5.23"
      }
    },
    {
      "path": "~/.bundle/cache",
      "type": "download",
      "table": "packageManagerCaches",
      "owner": "packageManagers",
      "treatment": "offer",
      "name": "Bundler cache",
      "recognition": "Folder name",
      "removal": "Trash",
      "restore": "Next `bundle install`. A network connection is necessary.",
      "verified": {
        "date": "2026-11-04",
        "macos": "27.2",
        "tool": "Bundler 2.5.23"
      }
    }
  ]
}

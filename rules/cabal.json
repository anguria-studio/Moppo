{
  "id": "cabal",
  "name": "cabal",
  "section": "elixir-haskell",
  "versionCommand": [
    "cabal",
    "--version"
  ],
  "storage": [
    {
      "path": "~/.local/state/cabal",
      "type": "installed",
      "table": "toolHomeLocations",
      "owner": "hiddenSystemData",
      "treatment": "protect",
      "name": "cabal package store",
      "identifiedBy": [
        "store/ghc-*"
      ],
      "explanation": "cabal keeps built packages here. Projects and programs from cabal install can need them.",
      "recognition": "`store/ghc-<version>` folder",
      "removal": "Never offer. Projects and programs from `cabal install` can need the store.",
      "restore": "Next build",
      "status": "Not verified. #350 checked the protection on the test Mac. No test removed the folder."
    },
    {
      "path": "~/.cache/cabal",
      "type": "download",
      "table": "packageManagerCaches",
      "owner": "packageManagers",
      "treatment": "review",
      "name": "Cabal packages (XDG)",
      "caveat": "cabal update downloads it again. A network connection is necessary.",
      "recognition": "cabal layout",
      "removal": "Trash after review",
      "restore": "`cabal update` and the next build. A network connection is necessary.",
      "verified": {
        "date": "2026-11-03",
        "macos": "27.2",
        "tool": "cabal 3.16.1.0"
      }
    },
    {
      "path": "~/.local/state/cabal/store",
      "type": "installed",
      "coverage": "protected",
      "recognition": "cabal layout",
      "removal": "Trash after review",
      "restore": "Next build for project dependencies",
      "verified": {
        "date": "2026-11-03",
        "macos": "27.2",
        "tool": "cabal 3.16.1.0"
      }
    },
    {
      "path": "<project>/dist-newstyle",
      "type": "build",
      "coverage": "no",
      "recognition": "`.cabal` file beside the folder",
      "removal": "Trash",
      "restore": "`cabal build`",
      "verified": {
        "date": "2026-11-02",
        "macos": "27.2",
        "tool": "cabal 3.16.1.0"
      }
    },
    {
      "path": "~/.cabal/packages",
      "type": "download",
      "table": "packageManagerCaches",
      "owner": "packageManagers",
      "treatment": "offer",
      "name": "Cabal packages",
      "recognition": "cabal layout",
      "removal": "Trash",
      "restore": "`cabal update`. A network connection is necessary.",
      "status": "Not verified. cabal 3.16 does not create this folder. Older cabal versions use it. See #323."
    }
  ]
}

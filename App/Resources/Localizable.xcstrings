    "Install the latest Moppo version before you reset access. An older build can lack the required Photos permission setting.": {
      "comment": "macOS privacy permission. Use the macOS names for privacy settings and preserve the Moppo app name.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la última versión de Moppo antes de restablecer el acceso. Es posible que una versión anterior no incluya el ajuste de permisos requerido para Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",

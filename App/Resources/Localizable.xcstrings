          "stringUnit": {
            "state": "translated",
            "value": "%@. Moppo vérifie chaque copie et le fichier à conserver octet par octet. Les gros fichiers prennent plus de temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Moppo verifica ogni copia e il file da conservare byte per byte. I file grandi richiedono più tempo."
          }
        }
      }
    },
    "%@. Each item is measured on disk before it goes, so large folders take a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Moppo mide cada elemento en el disco antes de eliminarlo. Las carpetas grandes tardan más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Moppo mesure chaque élément sur le disque avant de le supprimer. Les gros dossiers prennent plus de temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Moppo misura ogni elemento sul disco prima di rimuoverlo. Le cartelle grandi richiedono più tempo."
          }
        }
      }
    },
    "%@. Moppo checks the selected items before removal.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Moppo comprueba los elementos seleccionados antes de eliminarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Moppo vérifie les éléments sélectionnés avant de les supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Moppo controlla gli elementi selezionati prima di rimuoverli."
          }
        }
      }
    },
    "%@. Open iCloud settings.": {
      "localizations": {

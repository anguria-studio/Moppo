    "%@\nThis may take a few minutes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nEsto puede tardar unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@\nCela peut prendre quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@\nPotrebbero servire alcuni minuti."
          }
        }
      }
    },
    "%@ (%lld)": {
      "localizations": {
        "es": {
          "stringUnit": {

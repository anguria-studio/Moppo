          }
        }
      }
    },
    "Docker permanently removes %lld selected image. It does not move to the Trash. Image sizes include shared layers, so removal can recover less space.": {
      "comment": "Docker objects are not moved to the macOS Trash. A volume and its data cannot be restored. Keep Docker names and context identifiers unchanged.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Docker permanently removes %lld selected image. It does not move to the Trash. Image sizes include shared layers, so removal can recover less space."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Docker permanently removes %lld selected images. These images do not move to the Trash. Image sizes include shared layers, so removal can recover less space."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Docker elimina permanentemente %lld imagen seleccionada. No la traslada a la Papelera. El tamaño incluye capas compartidas, por lo que la eliminación puede liberar menos espacio."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Docker elimina permanentemente %lld imágenes seleccionadas. No las traslada a la Papelera. Los tamaños incluyen capas compartidas, por lo que la eliminación puede liberar menos espacio."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Docker supprime définitivement %lld image sélectionnée. Elle ne passe pas par la corbeille. La taille inclut les couches partagées, donc l’espace récupéré peut être inférieur."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Docker supprime définitivement %lld images sélectionnées. Elles ne passent pas par la corbeille. Leur taille inclut les couches partagées, donc l’espace récupéré peut être inférieur."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Docker elimina definitivamente %lld immagine selezionata. L’immagine non passa dal Cestino. Le dimensioni includono i livelli condivisi, quindi lo spazio recuperato può essere inferiore."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Docker elimina definitivamente %lld immagini selezionate. Le immagini non passano dal Cestino. Le dimensioni includono i livelli condivisi, quindi lo spazio recuperato può essere inferiore."
                }
              }
            }
          }
        }
      }
    },
    "Docker permanently removes %lld selected volume and all the data in it. Docker keeps no backup, so you cannot restore this data.": {
      "comment": "Docker objects are not moved to the macOS Trash. A volume and its data cannot be restored. Keep Docker names and context identifiers unchanged.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Docker permanently removes %lld selected volume and all the data in it. Docker keeps no backup, so you cannot restore this data."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Docker permanently removes %lld selected volumes and all their data. Docker keeps no backup, so you cannot restore this data."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Docker elimina definitivamente %lld volumen seleccionado y todos sus datos. Docker no guarda copias de seguridad. No puedes recuperar estos datos."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Docker elimina definitivamente %lld volúmenes seleccionados y todos sus datos. Docker no guarda copias de seguridad. No puedes recuperar estos datos."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Docker supprime définitivement %lld volume sélectionné et toutes ses données. Docker ne conserve aucune sauvegarde. Vous ne pouvez donc pas restaurer ces données."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Docker supprime définitivement %lld volumes sélectionnés et toutes leurs données. Docker ne conserve aucune sauvegarde. Vous ne pouvez donc pas restaurer ces données."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Docker elimina definitivamente %lld volume selezionato e tutti i suoi dati. Docker non conserva una copia di backup, quindi non puoi ripristinare questi dati."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Docker elimina definitivamente %lld volumi selezionati e tutti i loro dati. Docker non conserva una copia di backup, quindi non puoi ripristinare questi dati."
                }
              }
            }
          }
        }
      }
    },
    "Docker permanently removes this image and all its listed tags. It does not move to the Trash. Image sizes include shared layers, so removal can recover less space. Docker context: %@. %@": {
      "comment": "Docker objects are not moved to the macOS Trash. A volume and its data cannot be restored. Keep Docker names and context identifiers unchanged.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker elimina permanentemente esta imagen y todas las etiquetas de la lista. No la traslada a la Papelera. El tamaño incluye capas compartidas, por lo que la eliminación puede liberar menos espacio. Contexto de Docker: %1$@. %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Docker supprime définitivement cette image et toutes les étiquettes indiquées. L’image ne passe pas par la corbeille. Sa taille inclut les couches partagées, donc l’espace récupéré peut être inférieur. Contexte Docker : %@. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Docker elimina definitivamente questa immagine e tutti i tag elencati. L’immagine non passa dal Cestino. Le dimensioni includono i livelli condivisi, quindi lo spazio recuperato può essere inferiore. Contesto Docker: %@. %@"
          }
        }
      }
    },
    "Docker permanently removes this volume and all the data in it. Docker keeps no backup, so you cannot restore this data. Docker context: %@. Volume: %@": {
      "comment": "Docker objects are not moved to the macOS Trash. A volume and its data cannot be restored. Keep Docker names and context identifiers unchanged.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker elimina permanentemente este volumen y todos sus datos. No guarda una copia de seguridad. Estos datos no se pueden recuperar. Contexto de Docker: %1$@. Volumen: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Docker supprime définitivement ce volume et toutes ses données. Docker ne conserve aucune sauvegarde. Vous ne pouvez donc pas restaurer ces données. Contexte Docker : %@. Volume : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Docker elimina definitivamente questo volume e tutti i suoi dati. Docker non conserva una copia di backup, quindi non puoi ripristinarli. Contesto Docker: %@. Volume: %@"
          }
        }
      }
    },

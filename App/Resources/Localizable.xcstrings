    },
    "Some of those items are not what they were when you picked them. Review the updated list and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algunos elementos han cambiado desde que los seleccionaste. Revisa la lista actualizada y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains éléments ont changé depuis leur sélection. Vérifiez la liste mise à jour, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcuni elementi sono cambiati da quando li hai selezionati. Esamina l’elenco aggiornato e riprova."
          }
        }
      }
    },
    "Some photos are no longer available. Scan again before you delete photos.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas fotos ya no están disponibles. Vuelve a analizar antes de eliminar fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certaines photos ne sont plus disponibles. Relancez l’analyse avant de supprimer des photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcune foto non sono più disponibili. Avvia di nuovo la scansione prima di eliminare le foto."
          }
        }
      }
    },
    "Some selected items cannot go to the Trash. Their tools remove them permanently. Other selected items move to the Trash.": {
      "comment": "Permanent deletion. The item cannot be recovered from the Trash.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos elementos seleccionados no pueden ir a la Papelera. Las herramientas correspondientes los eliminan de forma permanente. Los demás elementos seleccionados se trasladan a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains éléments sélectionnés ne peuvent pas aller à la corbeille. Leurs outils les suppriment définitivement. Les autres éléments sélectionnés vont à la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcuni elementi selezionati non possono essere spostati nel Cestino. I relativi strumenti li eliminano definitivamente. Gli altri elementi selezionati vengono spostati nel Cestino."
          }
        }
      }
    },
    "Some snapshots may already have been deleted. Check the remaining snapshots before trying again.": {
      "comment": "Time Machine removal reported a failure. Some snapshots may have been deleted, so review the updated list before retrying.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es posible que algunas instantáneas ya se hayan eliminado. Comprueba las que quedan antes de volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains instantanés ont peut-être déjà été supprimés. Vérifiez ceux qui restent avant de réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcune istantanee potrebbero essere già state eliminate. Controlla le istantanee rimaste prima di riprovare."
          }
        }
      }
    },
    "Some sound content could not be read. Check access, then review the application again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se ha podido leer parte del contenido de sonido. Comprueba el acceso y vuelve a revisar la aplicación."
          }
        },
        "fr": {
          "stringUnit": {

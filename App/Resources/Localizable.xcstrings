{
  "sourceLanguage": "en",
  "strings": {
    "\nRetry with administrator approval to move eligible sound libraries to Trash.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\nVuelve a intentarlo con autorización de administrador para trasladar a la Papelera las bibliotecas de sonidos que cumplan los requisitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nRéessayez avec l’autorisation d’un administrateur pour placer les bibliothèques de sons éligibles dans la Corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\nRiprova con l’autorizzazione di amministratore per spostare nel Cestino le librerie di suoni idonee."
          }
        }
      }
    },
    "\nThe folders remain on disk. Select All to review their current status.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\nLas carpetas siguen en el disco. Selecciona Todo para revisar su estado actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nLes dossiers restent sur le disque. Sélectionnez Tout pour vérifier leur état actuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\nLe cartelle rimangono sul disco. Seleziona Tutti per controllarne lo stato attuale."
          }
        }
      }
    },
    "\nmacOS denied access to some items. Moppo left them in place. Review them in Finder.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\nmacOS ha denegado el acceso a algunos elementos. Moppo los ha dejado en su sitio. Revísalos en el Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nmacOS a refusé l’accès à certains éléments. Moppo les a laissés en place. Vérifiez-les dans le Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\nmacOS ha negato l’accesso ad alcuni elementi. Moppo li ha lasciati al loro posto. Controllali nel Finder."
          }
        }
      }
    },
    "\nmacOS denied access to some items. Review them in Finder.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\nmacOS ha denegado el acceso a algunos elementos. Revísalos en el Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nmacOS a refusé l’accès à certains éléments. Vérifiez-les dans le Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\nmacOS ha negato l’accesso ad alcuni elementi. Controllali nel Finder."
          }
        }
      }
    },
    " %lld file was eligible for comparison.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld file was eligible for comparison."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld files were eligible for comparison."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld archivo se pudo comparar."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld archivos se pudieron comparar."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " %lld fichier pouvait être comparé."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " %lld fichiers pouvaient être comparés."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " %lld file era idoneo al confronto."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " %lld file erano idonei al confronto."
                }
              }
            }
          }
        }
      }
    },
    " %lld photo had no thumbnail and was skipped.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld photo had no thumbnail and was skipped."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld photos had no thumbnails and were skipped."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Moppo omitió %lld foto porque no tenía miniatura."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Moppo omitió %lld fotos porque no tenían miniatura."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " %lld photo sans vignette a été ignorée."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " %lld photos sans vignette ont été ignorées."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " %lld foto è stata ignorata perché priva di miniatura."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " %lld foto sono state ignorate perché prive di miniature."
                }
              }
            }
          }
        }
      }
    },
    " Bursts and identical copies are unaffected — neither is decided by this number.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Este número no afecta a las ráfagas ni a las copias idénticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Cette valeur ne change ni les rafales ni les copies identiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Questo valore non influisce sulle raffiche o sulle copie identiche."
          }
        }
      }
    },
    " Download available runtimes again manually in Xcode Components.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Vuelve a descargar los entornos de ejecución disponibles desde Components en Xcode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Téléchargez à nouveau les runtimes disponibles dans la section Components de Xcode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Scarica di nuovo manualmente i runtime disponibili nella sezione Components di Xcode."
          }
        }
      }
    },
    " Found %lld verified duplicate set.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Found %lld verified duplicate set."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Found %lld verified duplicate sets."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Se ha verificado %lld grupo de duplicados."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Se han verificado %lld grupos de duplicados."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " %lld groupe de doublons vérifié a été trouvé."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " %lld groupes de doublons vérifiés ont été trouvés."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " Trovato %lld gruppo verificato di duplicati."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " Trovati %lld gruppi verificati di duplicati."
                }
              }
            }
          }
        }
      }
    },
    " Homebrew keeps the other installed versions of this formula.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Homebrew conserva las demás versiones instaladas de esta fórmula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Homebrew conserve les autres versions installées de cette formule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Homebrew conserva le altre versioni installate di questa formula."
          }
        }
      }
    },
    " No related files were removed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": " No se ha eliminado ningún archivo relacionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Aucun fichier associé n’a été supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Nessun file correlato è stato rimosso."
          }
        }
      }
    },
    " Only about %@ of that is storage this Mac will get back — the rest is shared with other copies still on this disk.": {
      "comment": "Shared physical storage. The item size can exceed the disk space recovered after removal.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " El Mac recuperará unos %@. El resto del espacio está compartido con otras copias que siguen en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Ce Mac ne récupérera qu’environ %@. D’autres copies toujours présentes sur le disque partagent le reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Questo Mac recupererà solo circa %@. Le altre copie sul disco condividono lo spazio restante."
          }
        }
      }
    },
    " Other files move to the Trash.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Los demás archivos se trasladan a la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Les autres fichiers sont placés dans la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Gli altri file vengono spostati nel Cestino."
          }
        }
      }
    },
    " Other selected items move to the Trash (%@).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Los demás elementos seleccionados se trasladan a la Papelera (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Les autres éléments sélectionnés sont placés dans la corbeille (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Gli altri elementi selezionati vengono spostati nel Cestino (%@)."
          }
        }
      }
    },
    " Projects may need another dependency download.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Es posible que los proyectos tengan que descargar de nuevo sus dependencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Certains projets peuvent nécessiter un nouveau téléchargement des dépendances."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " I progetti potrebbero dover scaricare di nuovo le dipendenze."
          }
        }
      }
    },
    " Protected data removal can erase profiles, history, or settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Eliminar datos protegidos puede borrar perfiles, historiales o ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " La suppression des données protégées peut effacer les profils, l’historique ou les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " La rimozione dei dati protetti può cancellare profili, cronologia o impostazioni."
          }
        }
      }
    },
    " Skipped %lld unreadable, changed, or cloud-only item.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Skipped %lld unreadable, changed, or cloud-only item."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Skipped %lld unreadable, changed, or cloud-only items."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Moppo omitió %lld elemento porque cambió, no se pudo leer o solo está en la nube."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Moppo omitió %lld elementos porque cambiaron, no se pudieron leer o solo están en la nube."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " %lld élément illisible, modifié ou uniquement dans le cloud a été ignoré."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " %lld éléments illisibles, modifiés ou uniquement dans le cloud ont été ignorés."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " Ignorato %lld elemento illeggibile, modificato o presente solo nel cloud."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " Ignorati %lld elementi illeggibili, modificati o presenti solo nel cloud."
                }
              }
            }
          }
        }
      }
    },
    " Some of these items share storage with each other and with copies still on this disk, so this Mac will get back at least %@ of that — never the whole %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Algunos elementos comparten espacio entre sí y con copias que siguen en el disco. El Mac recuperará al menos %1$@ y menos de %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Certains éléments partagent leur stockage avec d’autres éléments sélectionnés et des copies toujours sur le disque. Ce Mac récupérera au moins %@, sans pouvoir récupérer la totalité des %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Alcuni elementi condividono spazio tra loro e con copie ancora sul disco. Questo Mac recupererà almeno %@, senza recuperare tutti i %@."
          }
        }
      }
    },
    " These worktrees will move to the Trash.": {
      "comment": "Git worktree is a working directory linked to a Git repository. Keep inserted paths and branch names unchanged.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Estos worktrees se trasladarán a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Ces arbres de travail seront placés dans la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Questi worktree verranno spostati nel Cestino."
          }
        }
      }
    },
    " This includes %lld protected user-data item. Removal can sign you out and erase profiles, history, or settings.": {
      "comment": "This warning concerns app profiles, settings, sign-in data, or history. Some of these files can be shared by several apps.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " This includes %lld protected user-data item. Removal can sign you out and erase profiles, history, or settings."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " This includes %lld protected user-data items. Removal can sign you out and erase profiles, history, or settings."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " La selección incluye %lld elemento con datos de usuario protegidos. Si lo eliminas, se puede cerrar tu sesión o se pueden borrar tus perfiles, historiales o ajustes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " La selección incluye %lld elementos con datos de usuario protegidos. Si los eliminas, se puede cerrar tu sesión o se pueden borrar tus perfiles, historiales o ajustes."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " La sélection comprend %lld élément de données utilisateur protégées. Sa suppression peut vous déconnecter et effacer des profils, l’historique ou des réglages."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " La sélection comprend %lld éléments de données utilisateur protégées. Leur suppression peut vous déconnecter et effacer des profils, l’historique ou des réglages."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " La selezione include %lld elemento con dati utente protetti. La rimozione può disconnetterti e cancellare profili, cronologia o impostazioni."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": " La selezione include %lld elementi con dati utente protetti. La rimozione può disconnetterti e cancellare profili, cronologia o impostazioni."
                }
              }
            }
          }
        }
      }
    },
    " Unlocking does not select or remove items. Active sessions and other protected files stay locked.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Desbloquear no selecciona ni elimina elementos. Las sesiones activas y otros archivos protegidos siguen bloqueados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Le déverrouillage ne sélectionne et ne supprime aucun élément. Les sessions actives et les autres fichiers protégés restent verrouillés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Lo sblocco non seleziona né rimuove elementi. Le sessioni attive e gli altri file protetti restano bloccati."
          }
        }
      }
    },

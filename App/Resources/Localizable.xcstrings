            "value": "Questo elemento è archiviato su questo Mac e in iCloud. Spostarlo nel Cestino lo rimuove dagli altri dispositivi."
          }
        }
      }
    },
    "This item requires an application removal review.": {
      "localizations": {
        "es": {
          "stringUnit": {

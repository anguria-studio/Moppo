          "stringUnit": {
            "state": "needs_review",
            "value": "Certains éléments sont protégés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcuni elementi sono protetti"
          }
        }
      }
    },
    "Some Items Could Not Be Removed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido eliminar algunos elementos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains éléments n’ont pas pu être supprimés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rimuovere alcuni elementi"
          }
        }
      }
    },
    "Some apps are using cached files": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algunas apps utilizan archivos de caché"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certaines apps utilisent des fichiers de cache"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcune app usano file di cache"
          }
        }
      }
    },
    "Some files are in use by %@. Removing them now frees the same space but can disrupt those apps until they restart. Quit and Clean removes items only after the apps quit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos archivos están en uso por %@. Si los eliminas ahora, recuperarás el mismo espacio, pero podrías interrumpir esas apps hasta que se reinicien. Salir y limpiar elimina los elementos solo después de que las apps se cierren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains fichiers sont utilisés par %@. Leur suppression libère autant d’espace, mais peut perturber ces apps jusqu’à leur redémarrage. Quitter et nettoyer supprime les éléments uniquement après la fermeture des apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcuni file sono in uso da %@. La rimozione libera lo stesso spazio, ma può causare problemi a queste app fino al riavvio. Chiudi e pulisci rimuove gli elementi solo dopo aver chiuso le app."
          }
        }
      }
    },
    "Some files share storage, so category measurements can exceed used space.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algunos archivos comparten espacio. Por eso, las mediciones por categoría pueden superar el espacio utilizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains fichiers partagent leur stockage. Les mesures par catégorie peuvent donc dépasser l’espace utilisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcuni file condividono spazio. Le misure delle categorie possono quindi superare lo spazio utilizzato."
          }
        }
      }
    },
    "Some files were removed. Check Cleanup History for failures.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han eliminado algunos archivos. Revisa los errores en el historial de limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains fichiers ont été supprimés. Consultez l’historique de nettoyage pour voir les échecs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcuni file sono stati rimossi. Controlla la cronologia di pulizia per gli errori."
          }
        }
      }
    },
    "Some ignored files need review. Verified caches and dependencies appear separately.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hay que revisar algunos archivos ignorados. Las cachés y dependencias verificadas aparecen por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains fichiers ignorés doivent être vérifiés. Les caches et dépendances vérifiés s’affichent séparément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcuni file ignorati richiedono una verifica. Le cache e le dipendenze già verificate appaiono separatamente."
          }
        }
      }
    },
    "Some items remain in Trash": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedan elementos en la Papelera"
          }

    "Protected user data selected for removal. It will always move to the Trash.": {
      "comment": "This warning concerns app profiles, settings, sign-in data, or history. Some of these files can be shared by several apps.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han seleccionado datos de usuario protegidos. Moppo siempre los traslada a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Données utilisateur protégées sélectionnées pour la suppression. Elles vont toujours dans la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dati utente protetti selezionati per la rimozione. Vengono sempre spostati nel Cestino."
          }
        }
      }
    },
    "Protected while the app is running.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se protege mientras la app está en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Protégé pendant l’exécution de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Protetto mentre l’app è in esecuzione."
          }
        }
      }
    },
    "Protected: profiles, logins, history and settings may live here. Use the lock to review and select it separately.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegido. Puede contener perfiles, datos de inicio de sesión, historiales y ajustes. Usa el candado para revisar y seleccionar estos datos por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Protégé : peut contenir des profils, des identifiants, l’historique et des réglages. Utilisez le cadenas pour le vérifier et le sélectionner séparément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Protetto: può contenere profili, dati di accesso, cronologia e impostazioni. Usa il lucchetto per esaminarlo e selezionarlo separatamente."
          }
        }
      }
    },
    "Pull request #%lld is open. GitHub has all commits of this worktree, but the merge is not complete.": {
      "comment": "Git worktree is a working directory linked to a Git repository. Keep inserted paths and branch names unchanged.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud de incorporación de cambios #%lld sigue abierta. GitHub tiene todos los commits del worktree, pero la fusión sigue pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La pull request nº %lld est ouverte. GitHub contient tous les commits de cet arbre de travail, mais la fusion est incomplète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La pull request #%lld è aperta. GitHub contiene tutti i commit di questo worktree, ma l’unione non è completa."
          }
        }
      }
    },

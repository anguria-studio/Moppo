    "Review cancelled. No removal started. Moppo could not save the cancellation record.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se ha cancelado la revisión. No se ha iniciado la eliminación. Moppo no ha podido guardar el registro de cancelación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérification annulée. Aucune suppression n’a commencé. Moppo n’a pas pu enregistrer l’annulation."
          }
        },
        "it": {

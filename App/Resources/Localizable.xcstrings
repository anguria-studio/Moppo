          }
        }
      }
    },
    "Moppo could not complete this plan. It may be expired, changed, or unavailable. Check plan outcomes and Cleanup History.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no ha podido completar este plan. Es posible que haya caducado, haya cambiado o no esté disponible. Consulta los resultados del plan y el historial de limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo n’a pas pu terminer ce plan. Il peut avoir expiré, avoir changé ou être indisponible. Vérifiez les résultats du plan et l’historique de nettoyage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo non ha potuto completare questo piano. Potrebbe essere scaduto, modificato o non disponibile. Controlla i risultati del piano e la cronologia di pulizia."
          }
        }
      }
    },
    "Moppo could not delete all snapshots": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo no ha podido eliminar todas las instantáneas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",

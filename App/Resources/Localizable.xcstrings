    "This item is stored on this Mac and in iCloud. Moving it to the Trash removes it from other devices.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento está guardado en el Mac y en iCloud. Trasladarlo a la Papelera lo elimina de otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet élément est stocké sur ce Mac et dans iCloud. Le placer dans la corbeille le supprime des autres appareils."
          }
        },
        "it": {
          "stringUnit": {

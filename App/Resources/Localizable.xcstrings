      }
    },
    "Moppo could not check the selected items. Nothing was removed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no ha podido comprobar los elementos seleccionados. No se ha eliminado ningún elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",

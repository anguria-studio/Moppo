            "value": "Moppo non ha potuto verificare gli elementi selezionati. Non è stato rimosso nulla."
          }
        }
      }
    },
    "Moppo could not complete every check.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no ha podido completar todas las comprobaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",

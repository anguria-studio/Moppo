    "Safe to Remove": {
      "comment": "Cleanup classification for items that Moppo considers safe to remove. The same name appears in Shortcuts. Describes items whose contents can be created again, such as cache files.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminación segura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimable sans risque"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",

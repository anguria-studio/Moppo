    "Moppo checks current exclusions, protection, and file identities before showing the proposal.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo comprueba las exclusiones, la protección y la identidad de los archivos antes de mostrar la propuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo vérifie les exclusions, les protections et l’identité des fichiers avant d’afficher la proposition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo verifica le esclusioni, le protezioni e l’identità dei file prima di mostrare la proposta."
          }
        }
      }
    },
    "Moppo checks each item again before removal.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo vuelve a comprobar cada elemento antes de eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo vérifie de nouveau chaque élément avant sa suppression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo ricontrolla ogni elemento prima di rimuoverlo."
          }
        }
      }
    },
    "Moppo checks the selected worktrees again before removal. If a safety check fails, the worktrees stay on disk.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo vuelve a comprobar los worktrees seleccionados antes de eliminarlos. Si falla una comprobación de seguridad, los worktrees siguen en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo vérifie à nouveau les arbres de travail sélectionnés avant leur suppression. Si un contrôle de sécurité échoue, les arbres de travail restent sur le disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo ricontrolla i worktree selezionati prima della rimozione. Se un controllo di sicurezza non riesce, i worktree restano sul disco."
          }
        }
      }
    },
    "Moppo compares the contents of files in these folders.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo compara el contenido de los archivos de estas carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo compare le contenu des fichiers de ces dossiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo confronta il contenuto dei file di queste cartelle."
          }
        }
      }
    },
    "Moppo could not apply that setting to the sweep it has. Scan again to use it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no ha podido aplicar ese ajuste al último análisis. Vuelve a analizar para aplicarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo n’a pas pu appliquer ce réglage à l’analyse existante. Relancez l’analyse pour l’utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo non ha potuto applicare l’impostazione alla scansione esistente. Ripeti la scansione per usarla."
          }
        }
      }
    },
    "Moppo could not change this item. %@": {
      "localizations": {

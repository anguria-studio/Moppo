          }
        }
      }
    },
    "Moppo tries to move these applications to the Trash. Moppo asks again before permanent deletion. Related files move to the Trash.": {
      "comment": "Permanent deletion. The item cannot be recovered from the Trash.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo intenta trasladar estas apps a la Papelera. Pedirá otra confirmación antes de eliminarlas de forma permanente. Los archivos relacionados se trasladan a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo tente de placer ces applications dans la corbeille. Moppo demande une nouvelle confirmation avant toute suppression définitive. Les fichiers associés vont à la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo prova a spostare queste applicazioni nel Cestino. Chiede una nuova conferma prima dell’eliminazione definitiva. I file correlati vengono spostati nel Cestino."
          }
        }
      }
    },
    "Moppo uses your existing iCloud account. Full Disk Access lets Moppo read its storage information.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo usa tu cuenta de iCloud actual. El acceso total al disco permite a Moppo leer la información de almacenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo utilise votre compte iCloud existant. L’accès complet au disque lui permet de lire les informations de stockage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo usa il tuo account iCloud esistente. L’accesso completo al disco permette a Moppo di leggere le informazioni sullo spazio."
          }
        }
      }
    },

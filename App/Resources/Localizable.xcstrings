    "%@\n%@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@\n%@"
          }

          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo non ha potuto eliminare tutte le istantanee"
          }
        }
      }
    },
    "Moppo could not finish comparing the library. Nothing was deleted. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no ha podido terminar de comparar la fototeca. No se ha eliminado ninguna foto. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo n’a pas pu terminer la comparaison de la photothèque. Aucune photo n’a été supprimée. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo non ha potuto completare il confronto della libreria. Non è stato eliminato nulla. Riprova."
          }
        }
      }
    },
    "Moppo could not finish comparing those folders. Try scanning again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no ha podido comparar por completo esas carpetas. Vuelve a analizar."
          }
        },
        "fr": {
          "stringUnit": {

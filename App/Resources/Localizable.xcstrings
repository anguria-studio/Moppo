          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo non ha potuto completare il confronto delle cartelle. Ripeti la scansione."
          }
        }
      }
    },
    "Moppo could not finish measuring. Nothing was removed; try scanning again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no ha podido terminar la medición. No se ha eliminado ningún elemento. Vuelve a analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo n’a pas pu terminer la mesure. Aucun élément n’a été supprimé. Relancez l’analyse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo non ha potuto completare la misurazione. Non è stato rimosso nulla. Avvia di nuovo la scansione."
          }
        }
      }
    },
    "Moppo could not lock cleanup operations. No files were changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no ha podido bloquear las operaciones de limpieza. No se ha modificado ningún archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo n’a pas pu verrouiller les opérations de nettoyage. Aucun fichier n’a été modifié."
          }
        },
        "it": {

    "Categories that are off are never measured and never appear in Cleanup. Turning a category off does not delete anything.": {
      "comment": "Settings. Turning off a category only excludes that category from Cleanup scans.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no mide las categorías desactivadas ni las muestra en Limpieza. Desactivar una categoría no elimina ningún elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo ne mesure pas les catégories désactivées et ne les affiche pas dans Nettoyage. Désactiver une catégorie ne supprime aucun élément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo non misura le categorie disattivate e non le mostra in Pulizia. Disattivare una categoria non elimina alcun elemento."
          }
        }
      }
    },
    "Categories, exclusions and schedules return to defaults.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las categorías, las exclusiones y las programaciones vuelven a sus valores predeterminados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories, les exclusions et les planifications retrouvent leurs valeurs par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorie, esclusioni e pianificazioni tornano ai valori predefiniti."
          }
        }
      }
    },
    "Categories, exclusions and schedules return to their defaults. Nothing on disk is removed.": {

    "Moppo cannot access this folder. Check its permissions and try again.": {
      "comment": "macOS privacy permission. Use the macOS names for privacy settings and preserve the Moppo app name.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no puede acceder a esta carpeta. Comprueba sus permisos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo ne peut pas accéder à ce dossier. Vérifiez ses autorisations, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo non può accedere alla cartella. Controlla i permessi e riprova."
          }
        }
      }
    },
    "Moppo cannot change ~/.claude/settings.json. Edit the \"moppo *\" entry in sandbox.excludedCommands yourself.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no puede modificar ~/.claude/settings.json. Edita la entrada \"moppo *\" en sandbox.excludedCommands."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo ne peut pas modifier ~/.claude/settings.json. Modifiez l’entrée \"moppo *\" dans sandbox.excludedCommands."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo non può modificare ~/.claude/settings.json. Modifica la voce \"moppo *\" in sandbox.excludedCommands."
          }
        }
      }
    },
    "Moppo cannot change ~/.cursor/cli-config.json. Edit the \"Shell(moppo)\" entry in permissions.allow yourself.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no puede modificar ~/.cursor/cli-config.json. Edita la entrada \"Shell(moppo)\" en permissions.allow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo ne peut pas modifier ~/.cursor/cli-config.json. Modifiez l’entrée \"Shell(moppo)\" dans permissions.allow."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo non può modificare ~/.cursor/cli-config.json. Modifica la voce \"Shell(moppo)\" in permissions.allow."
          }
        }
      }
    },
    "Moppo cannot confirm which applications use this group container. If you remove it, other applications can lose their data and settings.": {
      "comment": "This warning concerns app profiles, settings, sign-in data, or history. Some of these files can be shared by several apps.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no puede confirmar qué apps usan este contenedor de grupo. Si lo eliminas, otras apps pueden perder sus datos y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo ne peut pas vérifier quelles applications utilisent ce conteneur de groupe. Si vous le supprimez, d’autres applications risquent de perdre leurs données et leurs réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo non può verificare quali applicazioni usano questo container di gruppo. Se lo rimuovi, altre applicazioni potrebbero perdere dati e impostazioni."
          }
        }
      }
    },
    "Moppo cannot read the Trash. Grant Full Disk Access to Moppo in System Settings.": {
      "comment": "macOS privacy permission. Use the macOS names for privacy settings and preserve the Moppo app name.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo no puede leer la papelera. Concede a Moppo acceso total al disco en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo ne peut pas lire la corbeille. Accordez à Moppo l’accès complet au disque dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo non può leggere il Cestino. Concedi a Moppo l’accesso completo al disco in Impostazioni di Sistema."
          }
        }
      }
    },
    "Moppo cannot remove this item directly. Use the terminal badge to review the command.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no puede eliminar este elemento directamente. Usa el icono de Terminal para revisar el comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo ne peut pas supprimer cet élément directement. Utilisez le badge de terminal pour vérifier la commande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moppo non può rimuovere questo elemento direttamente. Usa il badge del terminale per esaminare il comando."
          }
        }
      }
    },
    "Moppo cannot remove this whole folder. Review its child items separately.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo no puede eliminar esta carpeta entera. Revisa su contenido por separado."
          }
        },
        "fr": {
          "stringUnit": {

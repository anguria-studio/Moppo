    "macOS can free this space when it needs it. The estimate includes these snapshots and some system caches.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS puede liberar este espacio cuando lo necesite. La estimación incluye estas instantáneas y algunas cachés del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS peut libérer cet espace en cas de besoin. L’estimation comprend ces instantanés et certains caches système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS può liberare questo spazio quando gli serve. La stima include queste istantanee e alcune cache di sistema."
          }
        }
      }
    },
    "macOS deletes it when it needs space.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS la elimina cuando necesita espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS le supprime lorsqu’il a besoin d’espace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS la elimina quando serve spazio."
          }
        }
      }
    },
    "macOS deletes them when it needs space.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS las elimina cuando necesita espacio."
          }
        },
        "fr": {
          "stringUnit": {

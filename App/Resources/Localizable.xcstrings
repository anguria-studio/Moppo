            "value": "Si desactivas %1$@, Limpieza oculta %2$@. El total del Panel los sigue incluyendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous désactivez %1$@, Nettoyage masque %2$@. Le total du Tableau de bord les inclut toujours."
          }
        },
        "it": {

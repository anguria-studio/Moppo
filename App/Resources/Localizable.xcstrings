    },
    "The application is no longer at its original location. Moppo could not verify a Trash move. No related files were removed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app ya no está en su ubicación original. Moppo no ha podido verificar que se haya trasladado a la Papelera. No se ha eliminado ningún archivo relacionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",

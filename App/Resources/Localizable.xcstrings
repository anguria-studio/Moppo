    "The application and its helpers are asked to quit. Nothing is removed until they are gone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo pide que se cierren la app y sus procesos auxiliares. La eliminación empieza cuando se cierran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo demande à l’app et à ses processus auxiliaires de quitter. La suppression commence lorsqu’ils sont fermés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Moppo chiede all’app e ai suoi processi di chiudersi. La rimozione inizia dopo che si sono chiusi."
          }
        }
      }
    },
    "The application could not be removed.": {
      "localizations": {

    "The project changed on %@. Moppo waits until the project has no changes for 14 days. Moppo does not count it as safe to remove. You can still select it.": {
      "comment": "Scan result or progress text. Keep all replacement values. These can contain file paths, names, commands, or other data supplied by the scan.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project changed on %@. Moppo waits until the project has no changes for 14 days. Moppo does not count it as safe to remove. You can still select it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il progetto è cambiato il %@. Moppo aspetta che rimanga invariato per 14 giorni. La rimozione richiede una verifica. Puoi comunque selezionarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet a changé le %@. Moppo attend que le projet reste inchangé pendant 14 jours. Il ne le compte pas parmi les éléments supprimables sans risque. Vous pouvez toujours le sélectionner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto cambió el %@. Moppo espera a que el proyecto pase 14 días sin cambios. Moppo no lo clasifica como seguro. Puedes seleccionarlo de todos modos."
          }
        }
      }
    },

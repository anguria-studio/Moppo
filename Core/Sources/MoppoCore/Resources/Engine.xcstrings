    "%@ is open. Close %@, then scan again before removing this item.": {
      "comment": "Scan result or progress text. Keep all replacement values. These can contain file paths, names, commands, or other data supplied by the scan.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is open. Close %@, then scan again before removing this item."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è aperta. Chiudi %2$@, poi esegui una nuova scansione prima di rimuovere questo elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est ouverte. Fermez %2$@, puis relancez l’analyse avant de supprimer cet élément."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está abierta. Cierra %2$@ y vuelve a analizar antes de eliminar este elemento."
          }
        }
      }
    },
    "%@ is open. Close %@, then scan again to check whether these files are safe to remove.": {
      "comment": "Scan result or progress text. Keep all replacement values. These can contain file paths, names, commands, or other data supplied by the scan.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is open. Close %@, then scan again to check whether these files are safe to remove."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è aperta. Chiudi %2$@, poi esegui una nuova scansione per verificare se puoi rimuovere questi file in sicurezza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est ouverte. Fermez %2$@, puis relancez l’analyse pour savoir si la suppression de ces fichiers est sûre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está abierta. Cierra %2$@ y vuelve a analizar para comprobar si puedes eliminar estos archivos de forma segura."
          }
        }
      }
    },
